{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "mcp__Supabase",
      "mcp__github",
      "mcp__Claude_Code_Remote"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(git push --force origin main*)",
      "Bash(git push -f origin main*)"
    ]
  }
}
