# 신규 Supabase 프로젝트(ap-northeast-2 서울) 값으로 채우세요.
# service_role 키는 절대 여기에 두지 말 것 — Supabase Edge Function Secrets에만 보관.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# 초대 링크·메일에 들어갈 공개 주소. 커스텀 도메인이 정해지면 채우세요.
# 비워두면 접속한 주소(window.location.origin)를 그대로 씁니다.
# 예: https://app.example.com
VITE_SITE_URL=
