{
  // Cloudflare Workers (정적 자산) 배포 설정.
  // 대시보드 Workers & Pages → Import a repository 로 연결하면 이 파일을 읽습니다.
  //
  // 주의: VITE_* 값은 런타임 변수가 아니라 **빌드 시점**에 번들에 박힙니다.
  // 그래서 여기 vars 에 넣는 게 아니라 대시보드의 Build variables 에 등록해야 합니다.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hrd-aicapa-saas",
  "compatibility_date": "2026-08-10",
  "assets": {
    "directory": "./dist",
    // react-router SPA — 매칭되는 정적 파일이 없으면 index.html 로.
    // 실제 파일(/landing.html, /assets/*)은 이 규칙보다 우선합니다.
    "not_found_handling": "single-page-application"
  }
}
